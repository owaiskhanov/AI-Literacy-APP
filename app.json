{
  "expo": {
    "name": "AI Literacy",
    "slug": "ai-literacy",
    "scheme": [
      "ailiteracy",
      "com.ailiteracy.app"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ailiteracy.app"
    },
    "android": {
      "package": "com.ailiteracy.app",
      "versionCode": 2,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "com.ailiteracy.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A253A",
        "foregroundImage": "./assets/logo.png"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a9550ba4-b6c5-40fb-83fb-86754bf04750"
      },
      "geminiApiKey": "AQ.Ab8RN6K3JqGnId3q5NVKXEzuoRq0sk6WxuEKMSApd-FQ6kjLkQ"
    },
    "owner": "owaiskhanov"
  }
}
