{
  "expo": {
    "name": "AI Literacy",
    "slug": "ai-literacy",
    "scheme": "ailiteracy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ailiteracy.app"
    },
    "android": {
      "package": "com.ailiteracy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1A253A",
        "foregroundImage": "./assets/logo.png"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "a9550ba4-b6c5-40fb-83fb-86754bf04750"
      }
    },
    "owner": "owaiskhanov"
  }
}
